	column FX_rate = ```
			
			VAR CurrentDate = DimDate[date_key]
			
			VAR LastFXDate =
			    CALCULATE(
			        MAX(DimFX[date_key]),
			        FILTER(
			            ALL(DimFX),
			            DimFX[date_key] <= CurrentDate
			        )
			    )
			
			RETURN
			    CALCULATE(
			        MAX(DimFX[usd_per_eur]),
			        FILTER(
			            ALL(DimFX),
			            DimFX[date_key] = LastFXDate
			        )
			    )
			
			```
