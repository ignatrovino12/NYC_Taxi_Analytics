table FactAirQualityDaily
	lineageTag: 13e6cc5b-1ae5-4e5d-bf03-7f8d051eb812

	measure 'Average Sensor Coverage' = AVERAGE(FactAirQualityDaily[sensor_count])
		lineageTag: 9e78d1ef-23ee-441a-94b4-2e9c72309171

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PM25 Average' = CALCULATE( AVERAGE(FactAirQualityDaily[average_value]), FactAirQualityDaily[parameter_name] = "pm25")
		lineageTag: 9b70864d-9886-47a2-bb91-8af2cb3f0702

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reporting Sensors' = SUM(FactAirQualityDaily[sensor_count])
		formatString: 0
		lineageTag: 858b903d-9ed6-49a4-977a-6906f6c79eb1

	measure 'Total Measurements' = SUM(FactAirQualityDaily[total_measurements])
		formatString: 0
		lineageTag: ccb18d2c-ebb1-4bc3-8c6b-e121b82b4b15

	measure 'PM25 Index' =
			
			VAR BaseYearValue = CALCULATE([PM25 Average], REMOVEFILTERS(DimDate), DimDate[Year] = 2016)
			RETURN
			    DIVIDE([PM25 Average], BaseYearValue) * 100
		lineageTag: d8731c49-85db-4007-96c3-79f48b95d01b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

